# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:5000,http://10.0.2.2:5000
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://10.0.2.2:5000

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI
OPENAI_API_KEY=
GEMINI_API_KEY=

# Logging
LOG_LEVEL=info